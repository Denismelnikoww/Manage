# ==============================================================================
# LabFlow - Environment Variables Configuration (.env.example)
# ==============================================================================
# Скопируйте этот файл в .env перед запуском:
# cp .env.example .env (Linux / macOS) или copy .env.example .env (Windows)

# --- Backend Application ---
APP_NAME=LabFlow
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# --- Security & JWT Authentication ---
# Секретный ключ для подписи JWT-токенов (сгенерируйте с помощью openssl rand -hex 32)
SECRET_KEY=super_secret_jwt_key_labflow_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL) ---
POSTGRES_USER=labflow_user
POSTGRES_PASSWORD=labflow_secret_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labflow_db
DATABASE_URL=postgresql+psycopg://labflow_user:labflow_secret_password@localhost:5432/labflow_db

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_REPORTS=labflow-reports
MINIO_USE_SSL=False

# --- Telegram Bot Notifications ---
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=LabFlowBot

# --- Frontend Application (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
PORT=5173
